# Copy to .env and fill in locally. Never commit real keys.
# The room server does not read provider keys. Only host.mjs does.

# AGENT_LINK_URL=http://127.0.0.1:8770
# AGENT_LINK_TOKEN=
# AGENT_LINK_PROVIDER=offline
# XAI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.x.ai/v1
# AGENT_LINK_MODEL=grok-4.7
# AGENT_LINK_MAX_TURNS=12
# AGENT_LINK_MAX_CONSECUTIVE=4
# AGENT_LINK_MAX_TOKENS=20000
# AGENT_LINK_POLL_MS=2000

# Room server, single instance:
# HOST=127.0.0.1
# PORT=8770
# PUBLIC_ORIGIN=https://rooms.example.com
# TRUSTED_PROXY=1
# AGENT_LINK_DATA=/data
